# 复制为 .env.prod；文件由 Git 忽略。Node 22+ 启动时显式加载：
# node --env-file=.env.prod .output/server/index.mjs
NUXT_API_BASE=https://api.example.com/api/v1
NUXT_API_KEY=
NUXT_PROXY_SECRET=
NUXT_APP_VERSION=
NUXT_AUTH_COOKIE_SECURE=true
# 只填旧域名，不含协议或路径；支持逗号分隔多个域名。
NUXT_REDIRECT_HOSTS=
NUXT_PUBLIC_SITE_URL=https://tv.example.com
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_SITE_NAME=MiraiTV
NUXT_PUBLIC_SITE_DESCRIPTION="在 MiraiTV 发现电影、剧集与动漫：每日新番排期、高分推荐与剧场版，支持多播放源在线观看。"
NUXT_PUBLIC_SITE_LOGO=/brand/mirai-mark.webp
NUXT_PUBLIC_SITE_IMAGE=/og-image.jpg
NUXT_PUBLIC_SITE_TAGLINE="好的电影，是另一种人生体验。"
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
