# 复制为 .env 用于本地开发；生产示例见 .env.prod.example。
NUXT_API_BASE=http://127.0.0.1:8081/api/v1
# 仅在后端开启 APP_API_KEYS 时填写；服务端专用，不使用 NUXT_PUBLIC_ 前缀。
NUXT_API_KEY=
# 与后端 WEB_PROXY_SECRET 相同的随机密钥，修复 Pages 跨 zone 的访客 IP；仅服务端保存。
NUXT_PROXY_SECRET=
# 发布版本（例如发布标签或提交号），写入 app_logs.app_version。
NUXT_APP_VERSION=
NUXT_AUTH_COOKIE_SECURE=false
# 需要跳转到主站的旧域名，逗号分隔；留空不跳转。
NUXT_REDIRECT_HOSTS=
# canonical、robots、网站地图和分享链接使用的公开站点地址。
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# 留空可关闭统计；仅生产环境在首屏挂载后空闲加载。
NUXT_PUBLIC_GA_ID=
# 公开品牌配置：浏览器可见，不可用于保存密钥。
NUXT_PUBLIC_SITE_NAME=MiraiTV
NUXT_PUBLIC_SITE_DESCRIPTION="在 MiraiTV 发现电影、剧集与动漫：每日新番排期、高分推荐与剧场版，支持多播放源在线观看。"
NUXT_PUBLIC_SITE_LOGO=/brand/mirai-mark.webp
NUXT_PUBLIC_SITE_IMAGE=/og-image.jpg
NUXT_PUBLIC_SITE_TAGLINE="好的电影，是另一种人生体验。"
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
